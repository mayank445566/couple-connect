# Copy to .env (same folder as this file, OUTSIDE public_html) and fill in.
APP_NAME="Couple Connect"
APP_ENV=production          # production | local
APP_URL=https://api.example.com
# 64 hex chars. Generate: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Separate key for media encryption at rest (64 hex chars). Never change after launch.
MEDIA_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Absolute path, outside public_html
STORAGE_PATH=/home/CPANELUSER/couple-connect-storage

MIN_AGE=18
TOKEN_TTL_DAYS=90
EDIT_WINDOW_MINUTES=1440
DELETE_FOR_EVERYONE_WINDOW_MINUTES=2880
MAX_UPLOAD_MB=50

# Trust X-Forwarded-For only if behind Cloudflare/reverse proxy you control
TRUST_PROXY=false

# Mail: log | smtp
MAIL_DRIVER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl         # ssl | tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com

# Optional real-time relay on the VPS (Phase 4). Leave blank to use polling only.
RELAY_URL=
RELAY_SECRET=
