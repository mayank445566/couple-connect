# Copy to .env (same folder as this file, OUTSIDE public_html) and fill in.
APP_NAME="Couple Connect"
APP_ENV=production          # production | local
APP_URL=https://api.example.com
# 64 hex chars. Generate: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Separate key for media encryption at rest (64 hex chars). Never change after launch.
MEDIA_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Absolute path, outside public_html
STORAGE_PATH=/home/CPANELUSER/couple-connect-storage

MIN_AGE=18
TOKEN_TTL_DAYS=90
EDIT_WINDOW_MINUTES=1440
DELETE_FOR_EVERYONE_WINDOW_MINUTES=2880
MAX_UPLOAD_MB=50

# Trust X-Forwarded-For only if behind Cloudflare/reverse proxy you control
TRUST_PROXY=false

# Mail: log | smtp
MAIL_DRIVER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl         # ssl | tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com

# Optional real-time relay on the VPS (Phase 4). Leave blank to use polling only.
# RELAY_URL: where this server POSTs nudges (e.g. https://relay.yourdomain.com)
# RELAY_PUBLIC_URL: what the app connects to (e.g. wss://relay.yourdomain.com/ws)
# RELAY_SECRET: long random string, identical in relay/.env
RELAY_URL=
RELAY_PUBLIC_URL=
RELAY_SECRET=

# Calls (Phase 4). STUN helps peers find each other; TURN relays media when a direct path is blocked
# (common on mobile data). TURN_SECRET must equal static-auth-secret in coturn's turnserver.conf.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=21600

# Push notifications (Phase 4): fcm, log (writes storage/logs/push.log) or off.
# FCM_SERVICE_ACCOUNT: absolute path to the Firebase service-account JSON, OUTSIDE public_html.
PUSH_DRIVER=off
FCM_SERVICE_ACCOUNT=

# Payments (Phase 2). Key ID is public; secrets stay here only.
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# local testing only: create orders without calling Razorpay (works only with APP_ENV=local and a localhost APP_URL)
RAZORPAY_FAKE_ORDERS=false

# Admin panel (/admin): every admin must use two-step sign-in. Leave true.
ADMIN_REQUIRE_2FA=true

# Google Play Billing (Phase 6) for the Play Store build. See documentation/PAYMENTS.md.
# PLAY_SERVICE_ACCOUNT: absolute path to a service-account JSON with "View financial data" + "Manage orders"
# in Play Console, OUTSIDE public_html. PLAY_RTDN_TOKEN: long random string, also put in the Pub/Sub push URL.
PLAY_PACKAGE_NAME=com.coupleconnect.app
PLAY_SERVICE_ACCOUNT=
PLAY_RTDN_TOKEN=

# Day boundary for daily questions and streaks
APP_TIMEZONE=Asia/Kolkata
# Comma-separated web origins allowed to call the API from a browser (the mobile app does not need this)
CORS_ORIGINS=

# SMS for phone signup: log | msg91 | twilio
SMS_DRIVER=log
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
