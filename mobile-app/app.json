{
  "expo": {
    "name": "Couple Connect",
    "slug": "velora",
    "owner": "netsarthis-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coupleconnect.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE9F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.coupleconnect.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Couple Connect to record voice notes for your partner."
        }
      ],
      "expo-video",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Couple Connect to scan your partner's pairing QR code and take photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Couple Connect to share photos and videos with your partner."
        }
      ],
      "expo-sharing",
      "@config-plugins/react-native-webrtc",
      [
        "expo-notifications",
        {
          "color": "#E8456B"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**\n-keep class com.oney.WebRTCModule.** { *; }"
          }
        }
      ]
    ],
    "scheme": "coupleconnect",
    "extra": {
      "apiUrl": "https://api.example.com",
      "router": {},
      "eas": {
        "projectId": "e460b98d-a30c-4fef-a9bf-348c67272e2d"
      }
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
